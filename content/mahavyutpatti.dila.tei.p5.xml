          <cit type="translation" xml:lang="zho-Hant">
            <quote>修慧</quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>修生慧</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>bsgom pa las byung ba'i shes rab</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>བསྒོམ་པ་ལས་བྱུང་བའི་ཤེས་རབ་</quote>
          </cit>
        </entry>
