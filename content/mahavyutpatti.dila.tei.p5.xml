      <div>
        <head>八解脱</head>
        <entry key="1510">
          <form>
            <orth xml:lang="san-Latn">aṣṭau vimokṣāḥ</orth>
            <orth xml:lang="san-Deva">अष्टौ विमोक्षाः</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>八解脫</quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>八背捨</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>rnam par thar ba brgyad kyi ming la</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>རྣམ་པར་ཐར་བ་བརྒྱད་ཀྱི་མིང་ལ་</quote>
          </cit>
        </entry>
        <entry key="1511">
          <form>
            <orth xml:lang="san-Latn">rūpī rūpāṇi paśyaty ayaṃ prathamo vimokṣaḥ</orth>
            <orth xml:lang="san-Deva">रूपी रूपाणि पश्यत्ययं प्रथमो विमोक्षः</orth>
          </form>
