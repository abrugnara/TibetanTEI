      <div>
        <head>四依</head>
        <entry key="1545">
          <form>
            <orth xml:lang="san-Latn">catvāri pratisaraṇāni</orth>
            <orth xml:lang="san-Deva">चत्वारि प्रतिसरणानि</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>四依法</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>rton pa bzhi'i ming la</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>རྟོན་པ་བཞིའི་མིང་ལ་</quote>
          </cit>
        </entry>
        <entry key="1546">
          <form>
            <orth xml:lang="san-Latn">arthapratisaraṇena bhavitavyaṃ na vyañjanapratisaraṇena</orth>
            <orth xml:lang="san-Deva">अर्थप्रतिसरणेन भवितव्यं न व्यञ्जनप्रतिसरणेन</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>依義不依語</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>don la rton par bya ba'i tshig 'bru la rton par mi bya</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>དོན་ལ་རྟོན་པར་བྱའི་ཚིག་འབྲུ་ལ་རྟོན་པར་མི་བྱ་</quote>
          </cit>
        </entry>
        <entry key="1547">
          <form>
            <orth xml:lang="san-Latn">dharmapratisaraṇena bhavitavyaṃ na pudgalapratisaraṇena</orth>
            <orth xml:lang="san-Deva">धर्मप्रतिसरणेन भवितव्यं न पुद्गलप्रतिसरणेन</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>依法不依人</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>chos la rton par bya ba'i gang zag la rton par mi bya</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>ཆོས་ལ་རྟོན་པར་བྱའི་གང་ཟག་ལ་རྟོན་པར་མི་བྱ་</quote>
          </cit>
        </entry>
        <entry key="1548">
          <form>
            <orth xml:lang="san-Latn">jñānapratisaraṇena bhavitavyaṃ na vijñānapratisaraṇena</orth>
            <orth xml:lang="san-Deva">ज्ञानप्रतिसरणेन भवितव्यं न विज्ञानप्रतिसरणेन</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>依智不依識</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>ye shes la rton par bya ba'i rnam shes la rton par mi bya</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>ཡེ་ཤེས་ལ་རྟོན་པར་བྱའི་རྣམ་ཤེས་ལ་རྟོན་པར་མི་བྱ་</quote>
          </cit>
        </entry>
        <entry key="1549">
          <form>
            <orth xml:lang="san-Latn">nītārthasūtrapratisaraṇena bhavitavyaṃ na
              neyārthasūtrapratisaraṇena</orth>
            <orth xml:lang="san-Deva">नीतार्थसूत्रप्रतिसरणेन भवितव्यं न
              नेयार्थसूत्रप्रतिसरणेन</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>依了義不依不了義</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>nges pa'i don gyi mdo sde la rton pa bya ba'i drang ba'i don gyi mdo sde la rton
              par mi bya</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>ངེས་པའི་དོན་གྱི་མདོ་སྡེ་ལ་རྟོན་པ་བྱའི་དྲང་བའི་དོན་གྱི་མདོ་སྡེ་ལ་རྟོན་པར་མི་བྱ་</quote>
          </cit>
        </entry>
      </div>
