          <cit type="translation" xml:lang="zho-Hant">
            <quote>勿舐手</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>lag pa mi bldag pa</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>ལག་པ་མི་ལྡག་པ་</quote>
          </cit>
        </entry>
        <entry key="8588">
          <form>
            <orth xml:lang="san-Latn">na pātrāvalehakam</orth>
            <orth xml:lang="san-Deva">न पात्रावलेहकम्</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>勿舐缽</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>lhung bzed mi byog</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>ལྷུང་བཟེད་མི་བྱོག་</quote>
          </cit>
        </entry>
        <entry key="8589">
          <form>
            <orth xml:lang="san-Latn">na hastasaṃdhunakam</orth>
            <orth xml:lang="san-Deva">न हस्तसंधुनकम्</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>手勿抓癢</sic>
                <corr resp="ddbc">不振手</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">手勿摔</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>lag pa mi sprug</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>ལག་པ་མི་སྤྲུག་</quote>
          </cit>
        </entry>
        <entry key="8590">
          <form>
            <orth xml:lang="san-Latn">na pātrasaṃdhunakam</orth>
            <orth xml:lang="san-Deva">न पात्रसंधुनकम्</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>勿得離缽</sic>
                <corr resp="ddbc">不振缽</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">勿得覆缽</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>lhung bzed mi skyom</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>ལྷུང་བཟེད་མི་སྐྱོམ་</quote>
          </cit>
        </entry>
        <entry key="8591">
          <form>
            <orth xml:lang="san-Latn">na stūpākṛtimavamṛdya piṇḍapātaṃ paribhokṣyāmaḥ (na
              stūpākṛtimavamṛdya piṇḍapātraṃ paribhokṣyāmaḥ)</orth>
            <orth xml:lang="san-Deva">न स्तूपाकृतिमवमृद्य पिण्डपातं परिभोक्ष्यामः (न
              स्तूपाकृतिमवमृद्य पिण्डपात्रं परिभोक्ष्यामः)</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>如塔樣者勿食</sic>
                <corr resp="ddbc">不作窣覩波形食</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">勿作如塔樣食</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>mchod rten dang 'dra bar byas te zas mi bza'</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>མཆོད་རྟེན་དང་འདྲ་བར་བྱས་ཏེ་ཟས་མི་བཟའ་</quote>
          </cit>
        </entry>
        <entry key="8592">
          <form>
            <orth xml:lang="san-Latn">na sāmiṣeṇa pāṇinodakasthālakaṃ grahīṣyāmaḥ</orth>
            <orth xml:lang="san-Deva">न सामिषेण पाणिनोदकस्थालकं ग्रहीष्यामः</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>食飯殘手衣得取水</sic>
                <corr resp="ddbc">不以污手捉淨水瓶</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">食飯汗手勿得取水器</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>lag pas zas dang 'bags pas chu snod la mi gzung</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>ལག་པས་ཟས་དང་འབགས་པས་ཆུ་སྣོད་ལ་མི་གཟུང་</quote>
          </cit>
        </entry>
        <entry key="8593">
          <form>
            <orth xml:lang="san-Latn">na sāmiṣeṇodakenāntarikaṃ</orth>
            <orth xml:lang="san-Deva">न सामिषेणोदकेनान्तरिकं</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>前坐比丘食殘勿得酒</sic>
                <corr resp="ddbc">不以穢水灑比坐苾芻</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">近坐比丘身上勿得酒水</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>drung na 'dug pa'i dge slong la zas dang 'bags pa'i chu snod mi gtor</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>དྲུང་ན་འདུག་པའི་དགེ་སློང་ལ་ཟས་དང་འབགས་པའི་ཆུ་སྣོད་མི་གཏོར་</quote>
          </cit>
        </entry>
        <entry key="8594">
          <form>
            <orth xml:lang="san-Latn">nāvadhyānaprekṣiṇo 'ntarikasya bhikṣoḥ pātram
              avalokayiṣyāmaḥ</orth>
            <orth xml:lang="san-Deva">नावध्यानप्रेक्षिणोऽन्तरिकस्य भिक्षोः पात्रमवलोकयिष्यामः</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>近坐比丘缽盂勿得顧笑</sic>
                <corr resp="ddbc">不輕慢心觀比坐鉢中食</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>drung na 'dug pa'i dge slong gi lhung bzed la 'phyas gdags pa'i phyir mi
              blta</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>དྲུང་ན་འདུག་པའི་དགེ་སློང་གི་ལྷུང་བཟེད་ལ་འཕྱས་གདགས་པའི་ཕྱིར་མི་བལྟ་</quote>
          </cit>
        </entry>
        <entry key="8595">
          <form>
            <orth xml:lang="san-Latn">na sāmiṣam udakam antargṛhe chorayiṣyāmaḥ santaṃ gṛhiṇam
              anavalokya (na sāmikhom udakam antargṛhe chorayiṣyāmaḥ santaṃ gṛhiṇam
              anavalokya)</orth>
            <orth xml:lang="san-Deva">न सामिषमुदकमन्तर्गृहे छोरयिष्यामः सन्तं गृहिणमनवलोक्य (न
              सामिखोमुदकमन्तर्गृहे छोरयिष्यामः सन्तं गृहिणमनवलोक्य)</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>住家不問</sic>
                <corr resp="ddbc">在白衣舍不棄洗鉢水</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">殘食水勿得至家</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">不得未問而洗缽水棄白衣舍內</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>khyim du 'dug pa la ma dris par zas dang 'bags pa'i chu khyim pa'i khyim du mi
              dbo</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>ཁྱིམ་དུ་འདུག་པ་ལ་མ་དྲིས་པར་ཟས་དང་འབགས་པའི་ཆུ་ཁྱིམ་པའི་ཁྱིམ་དུ་མི་དབོ་</quote>
          </cit>
        </entry>
        <entry key="8596">
          <form>
            <orth xml:lang="san-Latn">na pātreṇa vighasaṃ cchorayiṣyāmaḥ</orth>
            <orth xml:lang="san-Deva">न पात्रेण विघसं च्छोरयिष्यामः</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>缽盂殘食勿得棄捨</sic>
                <corr resp="ddbc">不得以殘食置鉢水中</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">殘食勿得復入缽而棄</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>lhung bzed kyi nang du zas kyi lhag ma blugs te mi 'dor</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>ལྷུང་བཟེད་ཀྱི་ནང་དུ་ཟས་ཀྱི་ལྷག་མ་བླུགས་ཏེ་མི་འདོར་</quote>
          </cit>
        </entry>
        <entry key="8597">
          <form>
            <orth xml:lang="san-Latn">nānāstīrṇapṛthivīpradeśe pātraṃ sthāpayiṣyāmaḥ</orth>
            <orth xml:lang="san-Deva">नानास्तीर्णपृथिवीप्रदेशे पात्रं स्थापयिष्यामः</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>缽盂不可懸於虛空處</sic>
                <corr resp="ddbc">地上無替不應安鉢</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">缽盂不可放無座</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>'og gzhi med pa'i sa phyogs su lhung bzed mi bzhag</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>འོག་གཞི་མེད་པའི་ས་ཕྱོགས་སུ་ལྷུང་བཟེད་མི་བཞག་</quote>
          </cit>
        </entry>
        <entry key="8598">
          <form>
            <orth xml:lang="san-Latn">notthitāḥ pātraṃ nirmādayiṣyāmaḥ</orth>
            <orth xml:lang="san-Deva">नोत्थिताः पात्रं निर्मादयिष्यामः</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>勿得立洗缽盂</sic>
                <corr resp="ddbc">不立洗鉢</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>'grengs te lhung bzed mi bkru</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>འགྲེངས་ཏེ་ལྷུང་བཟེད་མི་བཀྲུ་</quote>
          </cit>
        </entry>
        <entry key="8599">
          <form>
            <orth xml:lang="san-Latn">na taṭe na prapāte na prāgbhāre pātraṃ sthāpayiṣyāmaḥ</orth>
            <orth xml:lang="san-Deva">न तटे न प्रपाते न प्राग्भारे पात्रं स्थापयिष्यामः</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>不可放險處岸下嚴上不平處</sic>
                <corr resp="ddbc">不於危險岸處置鉢</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>gad kha ma yin pa dang gyang sa ma yin pa dang dkan gzar po ma yin pa la lhung
              bzed gzhag par bya</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>གད་ཁ་མ་ཡིན་པ་དང་གཡང་ས་མ་ཡིན་པ་དང་དཀན་གཟར་པོ་མ་ཡིན་པ་ལ་ལྷུང་བཟེད་གཞག་པར་བྱ་</quote>
          </cit>
        </entry>
        <entry key="8600">
          <form>
            <orth xml:lang="san-Latn">na nadyāhāryāhāriṇyāṃ pratisrotaḥ pātreṇodakaṃ
              grahīṣyāmaḥ</orth>
            <orth xml:lang="san-Deva">न नद्याहार्याहारिण्यां प्रतिस्रोतः पात्रेणोदकं
              ग्रहीष्यामः</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>不可放常流緊水</sic>
                <corr resp="ddbc">不得逆流以鉢酌水</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">不可逆香暴流</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>'bab chu drag po'i rgyun las bzlog ste lhung bzed kyis chu mi bcu</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>འབབ་ཆུ་དྲག་པོའི་རྒྱུན་ལས་བཟློག་སྟེ་ལྷུང་བཟེད་ཀྱིས་ཆུ་མི་བཅུ་</quote>
          </cit>
        </entry>
        <entry key="8601">
          <form>
            <orth xml:lang="san-Latn">notthito niṣaṇṇāyāglānāya dharmaṃ deśayiṣyāmaḥ</orth>
            <orth xml:lang="san-Deva">नोत्थितो निषण्णायाग्लानाय धर्मं देशयिष्यामः</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>無病坐立處不可說法</sic>
                <corr resp="ddbc">人坐己立不為說法除病</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">不得立而為坐者說法除病</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>mi na bar 'dug pa la 'grengs te chos mi bshad</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>མི་ན་བར་འདུག་པ་ལ་འགྲེངས་ཏེ་ཆོས་མི་བཤད་</quote>
          </cit>
        </entry>
        <entry key="8602">
          <form>
            <orth xml:lang="san-Latn">na niṣaṇṇā nipannāyāglānāya dharmaṃ deśayiṣyāmaḥ</orth>
            <orth xml:lang="san-Deva">न निषण्णा निपन्नायाग्लानाय धर्मं देशयिष्यामः</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>無病坐臥處不可說法</sic>
                <corr resp="ddbc">人臥己坐不為說法除病</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">不得坐而為臥者說法除病</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>mi na bar nyal ba la 'dug ste chos mi bshad</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>མི་ན་བར་ཉལ་བ་ལ་འདུག་སྟེ་ཆོས་མི་བཤད་</quote>
          </cit>
        </entry>
        <entry key="8603">
          <form>
            <orth xml:lang="san-Latn">na nīcatarake niṣaṇṇā uccatarake āsane niṣaṇnāyāglānāya
              dharmaṃ deśayiṣyāmaḥ (na nīcastarake āsana uccatarake āsane niṣaṇnāyāglānāya dharmaṃ
              deśayiṣyāmaḥ)</orth>
            <orth xml:lang="san-Deva">न नीचतरके निषण्णा उच्चतरके आसने निषण्नायाग्लानाय धर्मं
              देशयिष्यामः (न नीचस्तरके आसन उच्चतरके आसने निषण्नायाग्लानाय धर्मं देशयिष्यामः)</orth>
          </form>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <choice>
                <sic>不得為高坐處下說法</sic>
                <corr resp="ddbc">人在高座己在下座不為說法除病</corr>
              </choice>
            </quote>
          </cit>
          <cit type="translation" xml:lang="zho-Hant">
            <quote>
              <del resp="ddbc">不得為高坐者說法除病</del>
            </quote>
          </cit>
          <cit type="translation" xml:lang="bod-Latn">
            <quote>mi na bar stan mthon po la stan dma' ba la 'dug ste chos mi bshad</quote>
          </cit>
          <cit type="translation" xml:lang="bod-Tibt">
            <quote>མི་ན་བར་སྟན་མཐོན་པོ་ལ་འདུག་པ་ལ་སྟན་དམའ་བ་ལ་འདུག་སྟེ་ཆོས་མི་བཤད་</quote>
          </cit>
        </entry>
        <entry key="8604">
          <form>
            <orth xml:lang="san-Latn">na pṛṣṭhato gacchantaḥ purato gacchate aglānāya dharmaṃ
              deśayiṣyāmaḥ</orth>
