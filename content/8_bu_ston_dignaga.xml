                <p xml:lang="bo">
                    <!-- ============================================================
                         SATZBAUPLAN-ANNOTATION (nach Schwieger/Bialek):
                         <s>   Satz
                           <cl> Klausel (type: main / dependent / relative / quotative)
                             <phr> Phrase mit syntaktischer Funktion:
                               function="S:Erg"    Subjekt im Ergativ
                               function="S:Abs"    Subjekt im Absolutiv
                               function="dO:Abs"   Direktes Objekt im Absolutiv
                               function="iO:PP"    Indirektes Objekt (Postpos.-Phrase)
                               function="SPrae:Abs" Subjektprädikativ
                               function="Praed:PP" Prädikat als Postpos.-Phrase
                               function="AB:lok"   Adverbialbestimmung Lokal
                               function="AB:temp"  Adverbialbestimmung Temporal
                               function="AB:kaus"  Adverbialbestimmung Kausal
                               function="AB:mod"   Adverbialbestimmung Modal
                               function="AB:final" Adverbialbestimmung Final
                               function="ThemaPart" Themapartikel (ni-Phrase)
                               function="ZitPart"  Zitierpartikel-Phrase
                               function="FinSuf"   Finalsuffix-Phrase
                               function="Konj"     Konjunktionsphrase
                               function="FokPart"  Fokuspartikel-Phrase
                               function="PlPart"   Pluralpartikel-Phrase
                               function="KSuf"     Kasussuffix-Phrase

                         TSEG-REGEL:
                           Der Tseg (་) steht als Textknoten ZWISCHEN den Tags,
                           nicht innerhalb von <w>. Beispiel:
                           <w>sloB dpon</w>་<w>chen po</w>་

                           Ausnahmen:
                           - Kein Tseg nach letztem Token vor | oder ||
                           - Komposita enthalten den Tseg INNERHALB von <w>:
                             <w>sloB dpon</w> (sloB-dpon = ein Token mit innerem Tseg)
                           - Bei Named Entities steht der Tseg nach </w>
                             aber innerhalb des Named-Entity-Tags:
                             <persName ...><w>dbyig gnyen</w>་</persName>

                         TOKEN-ANNOTATION (<w>):
                           xml:id    Pflicht: w[Seite]_[Satz]_[Token], z. B. w01_01_001
                           pos       Pflicht: POS-Tag (N, V.past, PART.case, ...)
                           type      Wortklasse (noun, verb, particle, adjective, ...)
                           subtype   Subkategorie (genitive, dative, personal_name, ...)
                           function  Kasus-/Partikelfunktion (genitive, dative, ...)
                           vclass    Verbklasse: VG1–VG6
                           valency   Valenz: tdV (transitiv) / tmdV (intransitiv)
                           sf        Stammform: 1.SF / 2.SF / 3.SF / 4.SF
                           lemma     Grundform (bei Verbformen)

                         BELEGSTELLEN (<note type="ref"> am <phr> oder <cl>):
                           Schwieger:  §[Abschn.] (S. [Seitenzahl]): [Anfang Beispielsatz]
                           Bialek Lek.: Lek. [Nr.], „[Überschrift]", Abschn. [a/b/c]: ...
                           Bialek CTG: Bialek (CTG), „[Überschrift]": ...
                           Bialek TB:  Bialek (TB), „[ÜBERSCHRIFT]": ...
                         ============================================================ -->
                    <!-- s01 དབྱིག་གཉེན་གྱི་སློབ་མ་ཚད་མ་རང་ལས་མཁས་པ་དཔལ་ལྡན་ཕྱོགས་ཀྱི་གླང་པོ་ནི། -->
                    <s xml:id="s01_01">
                        <cl type="main">
                            <phr function="S:Erg">
                                <!-- Nominale Phrase im Ergativ — Subjekt eines transitiven Verbs -->
                                <w xml:id="w01_01_001" pos="N.prop" type="noun"
                                    subtype="personal_name" corresp="#person_A"
                                    ><!-- Token 1 (ohne Tseg) --></w>་<w xml:id="w01_01_002"
                                    pos="PART.case" type="particle" subtype="agentive"
                                    function="agentive"><!-- Kasuspartikel gyis/kyis/gis --></w>
                                <note type="ref">Schwieger §79 (S. 52): rgyal pos</note>
                            </phr>
                            <phr function="dO:Abs">
                                <!-- Nominale Phrase im Absolutiv — direktes Objekt -->
                                <w xml:id="w01_01_003" pos="N" type="noun"
                                    ><!-- Token 3 (ohne Tseg) --></w>་<w xml:id="w01_01_004"
                                    pos="PART.case" type="particle" subtype="genitive"
                                    function="genitive"><!-- Kasuspartikel kyi/gyi/gi --></w>
                            </phr>
                            <phr function="Praed:PP">
                                <!-- Verbphrase — Prädikat -->
                                <w ana="VG3 tdV 2.SF" xml:id="w01_01_005" pos="V.past" type="verb"
                                    ><!-- Verbform --></w>
                            </phr>
                        </cl>
                        <pc xml:id="pc01_01_01" type="shad">།</pc>
                    </s>
